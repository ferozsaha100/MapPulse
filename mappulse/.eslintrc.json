{
	"root": true,
	"extends": [
		"plugin:@wordpress/eslint-plugin/recommended"
	],
	"env": {
		"browser": true
	},
	"rules": {
		"import/no-extraneous-dependencies": "off",
		"import/no-unresolved": "off",
		"jsdoc/require-param-type": "off",
		"jsdoc/require-returns-type": "off"
	},
	"overrides": [
		{
			"files": [
				"**/test/**/*.js",
				"tests/e2e/**/*.js"
			],
			"env": {
				"jest": true,
				"node": true
			}
		}
	]
}
