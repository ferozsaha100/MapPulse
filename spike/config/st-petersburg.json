  "style": {
    "water": "#DCE8EA",
    "coast": "#B4C9CF",
    "land": "#F6F1E6",
    "context": "#EEE7D8",
    "contextStroke": "#FFFFFF",
    "zone": "#DCCFB6",
    "zoneStroke": "#FFFFFF",
    "zoneHover": "#1F3A5F",
    "label": "#2B2F36",
    "waterLabel": "#3F6470",
    "roadCasing": "#BDB198",
    "road": "#FFFFFF",
    "labelFont": "Inter, Helvetica, Arial, sans-serif",
    "labelSize": 11.5
  }
}
